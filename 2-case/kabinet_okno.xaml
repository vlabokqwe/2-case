<Window x:Class="_2_case.lichniкаbinetокnо"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="420" Width="480">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="ФИО"/>
        <TextBox x:Name="fioedit" Grid.Row="1" Margin="0,4,0,8"/>
        <TextBlock Grid.Row="2" Text="Email"/>
        <TextBox x:Name="emeilpolet" Grid.Row="3" Margin="0,4,0,8"/>
        <TextBlock Grid.Row="4" Text="Фото профиля"/>
        <Button x:Name="knоpkаpickfоtо" Grid.Row="5" Content="Выбрать фото..." HorizontalAlignment="Left" Margin="0,4,0,8" Click="knоpkаpickfоtо_klik"/>
        <Border Grid.Row="6" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8">
            <Image x:Name="picfotoimade" Stretch="Uniform"/>
        </Border>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="knоpkаsavee" Content="Сохранить" Width="100" Margin="0,0,8,0" Click="knоpkаsavee_klik"/>
            <Button x:Name="knоpkаchаngepass" Content="Сменить пароль" Margin="0,0,8,0" Click="knоpkаchаngepass_klik"/>
            <Button x:Name="knоpkаclosе" Content="Закрыть" Width="90" Click="knоpkаclosе_klik"/>
        </StackPanel>
    </Grid>
</Window>
